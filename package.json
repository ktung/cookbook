{
  "name": "cookbook",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.20.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^10.34.5",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "pnpm dlx @biomejs/biome format --write src",
    "format-full": "pnpm dlx @biomejs/biome check --write src",
    "lint": "pnpm dlx @biomejs/biome check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@types/js-yaml": "^4.0.9",
    "@types/sanitize-html": "^2.16.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "js-yaml": "^5.4.1",
    "marked": "^18.0.11",
    "sanitize-html": "2.17.5",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "8.2.2"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.24.1",
    "@sveltejs/adapter-vercel": "^6.3.4",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "svelte": "^5.56.10"
  }
}
